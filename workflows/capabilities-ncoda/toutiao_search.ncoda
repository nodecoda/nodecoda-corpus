// toutiao_search.ncoda — capability header (provider = file name)
// desc: 头条搜索
@language nodecoda/1

type ToutiaoSearchBrowseResult = {
  ToutiaoSearchBrowseData data;

  int errcode;

  string errmsg;

  string log_id;

  bool ok;

  int status_code;
};

type ToutiaoSearchBrowseData = {
  string content;

  string title;
};

@capability failure_branch=true, timeout_ms=180000
function browse(string prompt = "", any url) -> ToutiaoSearchBrowseResult {}
type ToutiaoSearchSearchResult = {
  ToutiaoSearchSearchData data;

  int errcode;

  string errmsg;

  string log_id;

  bool ok;

  int status_code;
};

type ToutiaoSearchDoc = {
  string title;

  string url;
};

type ToutiaoSearchSearchData = {
  int cursor;

  array<ToutiaoSearchDoc> doc_results;

  bool has_more;

  string search_id;
};

@capability failure_branch=true, timeout_ms=180000
function search(int count = 0, int cursor = 0, string input_query = "", string search_id = "") -> ToutiaoSearchSearchResult {}
