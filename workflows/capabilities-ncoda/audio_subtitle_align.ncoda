// audio_subtitle_align.ncoda — capability header (provider = file name)
// desc: 字幕音频自动对齐
@language nodecoda/1

type AudioSubtitleAlignAlignTextToAudioV2Result = {
  float duration;

  string msg;

  array<string> texts;

  array<any> timelines;
};

@capability failure_branch=true, timeout_ms=180000
function align_text_to_audio_v2(any audio_url, any text) -> AudioSubtitleAlignAlignTextToAudioV2Result {}
