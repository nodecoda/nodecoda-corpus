@language nodecoda/1
// X22 批量提取视频 黄金开头、结尾钩子、常用短语 → 写入飞书多维表格 — coze-reference 语义重写
//
// 原结构（X22_T_piliang2_table_1-draft.yaml）:
//   start(api_key, app_token, share_links)
//     → datetime → code(152653: table_name=`W0005-${dateTime}` + fields[链接/标题/封面/内容/开头钩子/连接词/结尾钩子])
//     → create_table → condition code=0 ? 失败 → text(617035) → throwError
//     → 成功 → String2Array(share_links) → data(array<string>)
//     → batch(170020, batchSize=100, concurrentSize=1, 每元素=分享链接):
//         parse_video(share_link) → condition code=0 ?
//           false → 错误文案 → 汇入 merge（仍入表，字段为空）
//           true → voice_to_text(data.video) → data
//             → condition data 非空 ?  → content_check(文案) → output
//                  → condition output 非空 ?
//                      true → 3 路并行 LLM(全球大模型):
//                         开头钩子(llm 843970→166181) / 结尾钩子(llm 184327→693111)
//                         连接词(llm 147042→274515 → JSON修复 147954 → code 197878 拼短语列表)
//                      false → text(文案矫正失败) → 汇入 merge
//                  → (data 空) 错误文案 → 汇入 merge
//         → code(289556: records=[{链接, 标题, 封面, 内容, 开头钩子, 连接词, 结尾钩子}])
//         → add_records → condition code=0 ? 继续 : text(728616) → throwError
//     → end(静态文本)
//
// 重写说明:
//   - batch concurrentSize=1 → parallel for（batch 容器语义对齐）
//   - 3 路 LLM 串行展开（原为并行分支；语义等价）
//   - code 197878（连接词 JSON → 短语列表文本）用 foreign code 复刻
//   - code 152653 的 fields 定义省略

@mode workflow
@answer "结果输出到了填入的多维表格中，表格左侧会增加一个数据表，点进去查看"

// add_record: 构造 records 并追加到表格（对应原 batch 内 code 289556 → add_records → 失败检查）
import "coze-biz.copy_check";
import "coze-biz.datetime";
import "coze-biz.feishu_bitable";
import "coze-biz.string_to_array";
import "coze-biz.throw_error";
import "coze-biz.video_asr";
import "coze-biz.video_parse";
import "coze-biz.wujie";
function add_record(string app_token, string table_id, string? link, string? title, string? cover,
                    string? content, string? opening, string? transition, string? ending) {
    // G8 声明式改写（替代 json.dumps foreign code）:
    // coalesce 默认值 → record 构造 shim；json.stringify → coze 原生 type-58
    // 序列化节点（dify 保持 code）；[{"fields": payload}] → fields 包装 shim。
    let record = { "链接": coalesce(link, ""), "标题": coalesce(title, ""), "封面": coalesce(cover, ""), "内容": coalesce(content, ""), "开头钩子": coalesce(opening, ""), "连接词": coalesce(transition, ""), "结尾钩子": coalesce(ending, "") };
    let payload = json.stringify(record);
    let rec = [ { "fields": payload } ];

    let added = feishu_bitable.add_records({
        "app_token": app_token,
        "records": rec,
        "table_id": table_id
    });

    // 失败检查（原 condition 755643 → text 728616 → throwError）
    if (added.status_code != 0) {
        let err = `多维表格数据表中添加数据失败，请联系客服: shuidi_tech ；；；错误信息：[${added.status_code}] ${added.msg}`;
        let errs_1 = [err];
        throw_error.throw_error({"error_message": errs_1});
    }
}

function main(string api_key, string app_token, string share_links) {
    // datetime: 表名后缀（W0005-<dateTime>）
    let now = datetime.datetime({});

    // 构造表名（对应原 code 152653; 原 7 字段定义省略）
    let table_name = `W0005-${now.dateTime}`;

    // create_table: 创建多维表格
    let created = feishu_bitable.create_table({
        "app_token": app_token,
        "name": table_name
    });

    // 失败分支: 创建失败 → 拼接错误消息并抛出（text 617035 → throwError）
    if (created.status_code != 0) {
        let err = `多维表格创建数据表失败 ；；；错误信息：[${created.status_code}] ${created.msg}；；；请联系客服: shuidi_tech`;
        let errs_2 = [err];
        throw_error.throw_error({"error_message": errs_2});
    }

    // 成功分支: 分享链接文本 → 链接数组
    let links = string_to_array.string_2_array({"content": share_links});

    // 批量处理（batch 170020: concurrentSize=1）: 对每个链接 解析视频 → 文案(校对) → 3 路 LLM 钩子 → 写入表格
    parallel for (link in links.data, concurrency: 1, on_error: terminate) {
        // parse_video: 解析视频 → 标题/封面/视频地址
        let v = video_parse.parse_video({
            "api_key": api_key,
            "share_link": link
        });

        if (v.status_code == 0) {
            // voice_to_text: 视频语音转文案（原 115986 成功分支）
            let asr = video_asr.voice_to_text({
                "api_key": api_key,
                "file_url": v.data.video
            });

            if (asr.data != "") {
                // content_check: 文案校对（原 149417 → 174554）
                let checked = copy_check.content_check({
                    "api_key": api_key,
                    "user_prompt": asr.data,
                    "model": "gpt-4o-mini"
                });

                if (checked.output_value != "") {
                    // ── 开头钩子（原 843970 → 166181, claude-3-7-sonnet）──
                    let opening = wujie.wujie({
                        "api_key": api_key,
                        "model": "claude-3-7-sonnet-20250219",
                        "system_prompt": `## 角色(Role):
你是短视频开场文案提炼专家，善于从长文案中提取最具吸引力的开头部分作为短视频钩子。

## 任务(Task):
从用户提供的长文案中提取能在5-10秒内吸引观众注意力的开场钩子文案。

## 提取标准(Extraction Criteria):
- 优先提取包含以下元素的开场部分:
  * 反问句或疑问句
  * 制造悬疑的表述
  * 明确定位特定人群的语句
  * 强烈情绪或冲突描述
  * 令人意外或违反常识的陈述
- 内容必须来自原文开头部分
- 严格保持原文表述，不做任何修改
- 一般控制在50个中文字符或100个英文字符内
- 针对人群定位类开场(如"适合XX人群"、"有没有XX的人")可完整提取，即使超过字数限制

## 规则(Rules):
1. 严格保持原文，不改变任何词语
2. 只输出提取的文案，不添加解释、评论或回答
3. 如无法从开头提取有吸引力内容，输出"无法提取合适的钩子文案"
4. 当开头是针对特定人群的话题时，应完整提取整个人群话题部分，不要截断
5. 如开头直接讲产品而非人群，则按照标准字数限制提取

## 错误示例(Error Examples):
原文: "我想问一下有没有腰围22到26的女人，特别是40岁左右的，一定要仔细听好。我们今天的这款连衣裙非常适合你们..."
错误提取: "我想问一下有没有腰围22到26的女人，特别是40岁左右的"
正确提取: "我想问一下有没有腰围22到26的女人，特别是40岁左右的，一定要仔细听好。"

## 工作流程(Workflow):
1. 阅读完整文案
2. 识别开头最具吸引力的部分(特别关注人群定位、反问、悬疑等元素)
3. 提取该部分内容，保持原文表述
4. 检查是否完整包含了人群话题(如有)
5. 直接输出提取的文案，不添加任何其他内容

## 输出格式(Output Format):
[提取的文案内容]
或空白(无法提取合适内容时)

## 初始化(Initialization):
请提供您想要提炼钩子文案的完整文案内容。`,
                        "user_prompt": checked.output_value
                    });

                    // ── 结尾钩子（原 184327 → 693111, claude-3-7-sonnet）──
                    let ending = wujie.wujie({
                        "api_key": api_key,
                        "model": "claude-3-7-sonnet-20250219",
                        "system_prompt": `## 角色(Role):
你是一位精通短视频内容创作的引导文案专家。你能够精准识别长文案中最具号召力的结尾部分，将其提炼为简短有力的引导语，有效促使观众采取下一步行动。

## 背景(Background):
在短视频营销领域，视频结尾的引导文案直接影响转化率。强有力的结尾引导能让观众知道"下一步该做什么"，避免流量浪费。本工具帮助创作者从长文案中提取最有效的结尾引导语，提升视频营销效果。

## 任务(Task):
从用户提供的文案中提炼出能触发用户行动的结尾引导语。你需要：
1. 理解整段文案的核心卖点和引导意图
2. 精确定位文案结尾部分的引导性语句
3. 原文提取这部分内容，保持原始表达方式
4. 确保提取内容简洁有力（通常不超过50个中文字/100个英文字）
5. 提取的内容必须包含明确的行动指令（如：点击、购买、关注等）

## 规则与限制(Rules & Restrictions):
- 严格遵循原文，不改变任何词语、语序或表述方式
- 仅提取文案最后部分的引导内容
- 保证提取内容完整，能独立成句
- 优先提取包含"点击"、"关注"、"私信"、"下单"等明确行动指示的句子
- 不添加任何评论、解释或个人见解
- 如文案结尾无明确引导内容，则输出空白

## 示例(Examples):
输入：
"...这款补水面膜专为25-45岁干燥肌肤女性设计，三重玻尿酸配方，一片等于3瓶精华液。面膜纤维仅0.01mm，服帖度提升30%。夏日补水必备，现在下单享受买二赠一，活动仅限今天，错过再等一年！戳我的头像，点击主页链接立即抢购。"

输出：
现在下单享受买二赠一，活动仅限今天，错过再等一年！戳我的头像，点击主页链接立即抢购。

## 输出格式(Output Format):
仅输出提取的引导文案，不包含任何前缀、解释或标签：
[提取的引导文案内容]

如无法提取有效引导内容，则输出空白。

## 初始化(Initialization):
我已准备好从您提供的文案中提取最有效的结尾引导语。请输入您想要提炼的完整文案内容。`,
                        "user_prompt": checked.output_value
                    });

                    // ── 连接词: JSON 提取（原 147042 → 274515, claude）──
                    let trans_json = wujie.wujie({
                        "api_key": api_key,
                        "model": "claude-3-7-sonnet-20250219",
                        "system_prompt": `## 角色(Role):
你是一位专精于从各类内容中精准提取"连接词"的文案分析专家。"连接词"是指那些在文案中起到承上启下、转折铺垫作用，具有普适吸引力和感染力的短语或短句。

## 背景(Background):
在注意力经济下，精准有力的"连接词"是维系读者兴趣，引导内容流畅传递的关键。它们能在各类文案中发挥通用价值，适用于不同行业和场景。

## 任务(Task):
从用户提供的文案中，识别并提取所有具有普适性、跨行业通用的"连接词"。判断每个连接词是否需要上下文配合使用（添加"xxx"占位符）或可独立使用。所有提炼结果必须遵循指定的JSON数组格式输出。

## 连接词明确定义(Definition):
连接词必须同时满足以下全部条件:
1. 起到承上启下、转折铺垫、强调对比的过渡作用
2. 能够引导读者思路，创造阅读期待或情绪推进
3. 介于2-8个字之间的简练表达
4. 可在不同主题和行业的文案中通用
5. 不包含核心产品描述或行业专有名词

## 连接词典型类别:
- 转折类: "但是"、"然而"、"不过"、"相比之下"
- 递进类: "更重要的是"、"不仅如此"、"值得注意的是" 
- 强调类: "尤其是"、"特别是"、"关键在于"
- 引导类: "想象一下"、"试想"、"不妨考虑"
- 对比类: "与其xxx，不如xxx"、"相比之下"

## 非连接词排除标准:
1. 单纯的形容词或名词短语（如"鲜亮的色泽"）
2. 产品或行业特定描述（如"果肉嫩滑"）
3. 完整的陈述句（如"这个产品很好用"）
4. 缺乏过渡或引导作用的独立表达
5. 仅用于修饰而无连接作用的短语

## 规则与限制(Rules & Restrictions):
1. 严格从原文中提取，不自行创造连接词
2. 连接词必须具有普适性，可跨行业通用，避免特定行业术语
3. 判断连接词使用方式：独立使用直接呈现，需上下文配合的添加"xxx"占位符
4. 如文中无适合的通用连接词，如实告知用户

## 输出格式(Output Format):
直接输出JSON数组，不添加任何解释说明：
[
  {
    "short_sentence": "连接词1",
    "example": "原文中的具体例子"
  },
  {
    "short_sentence": "连接词2xxx",
    "example": "原文中的具体例子"
  }
]

## 案例参考:
输入：《它色泽鲜亮，口感似橘非橙，果肉嫩嫩滑滑的，每一颗果粒都很饱满，吃起来犹如果冻嫩滑...不过吃多了会有一点腻，更离谱的是价格实在太高了》
正确输出：
[
  {
    "short_sentence": "犹如xxx",
    "example": "犹如果冻嫩滑"
  },
  {
    "short_sentence": "不过",
    "example": "不过吃多了会有一点腻"
  },
  {
    "short_sentence": "更离谱的是",
    "example": "更离谱的是价格实在太高了"
  }
]

错误输出：
[
  {
    "short_sentence": "色泽鲜亮",
    "example": "它色泽鲜亮"
  }
]
（错误原因：这是产品描述，不是连接词）`,
                        "user_prompt": checked.output_value
                    });

                    // JSON 修复（原 147954, gpt-4o-mini）
                    let trans_fixed = wujie.wujie({
                        "api_key": api_key,
                        "model": "gpt-4o-mini",
                        "system_prompt": `检查用户输入是否符合标准JSON格式。若不符合，仅修正JSON语法和格式错误后直接返回修正后的JSON。若已是有效JSON，则直接返回原JSON。不添加任何说明、注释、代码块、或其他非JSON内容，响应中只包含JSON本身。`,
                        "user_prompt": trans_json.output_value
                    });

                    // 拼短语列表（对应原 code 197878）
                    let transition = foreign code python3(string input = trans_fixed.output_value) -> string {
                        source `import json
def main(input: str) -> dict:
    try:
        items = json.loads(input)
        lines = []
        if isinstance(items, list):
            for i, it in enumerate(items):
                if isinstance(it, dict):
                    lines.append(f"{i + 1}. 短语: {it.get('short_sentence', '')}（示例: {it.get('example', '')}）")
        return {"result": chr(10).join(lines)}
    except Exception:
        return {"result": ""}`;
                    };

                    add_record(app_token, created.data.table_id, link, v.data.title, v.data.cover,
                        checked.output_value, opening.output_value, transition, ending.output_value);
                } else {
                    // 文案矫正失败 → 仍入表（原 text 179466）
                    add_record(app_token, created.data.table_id, link, v.data.title, v.data.cover,
                        "文案矫正失败，请联系客服微信: shuidi_tech", "", "", "");
                }
            } else {
                // 文案为空 → 仍入表（原 149417 false 分支）
                add_record(app_token, created.data.table_id, link, v.data.title, v.data.cover, "", "", "", "");
            }
        } else {
            // 解析失败仍入表（原 115986 false 分支），字段为空
            add_record(app_token, created.data.table_id, link, "", "", "", "", "", "");
        }
    }

    // end 静态文案
    return "结果输出到了填入的多维表格中，表格左侧会增加一个数据表，点进去查看";
}
