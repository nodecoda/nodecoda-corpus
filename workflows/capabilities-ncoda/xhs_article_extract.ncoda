// xhs_article_extract.ncoda — capability header (provider = file name)
// desc: 小红书文章信息提取
@language nodecoda/1

type XhsArticleExtractExtractXhsArticleWebinfoResult = {
  XhsArticleExtractExtractXhsArticleWebinfoArticleinfo articleInfo;

  XhsArticleExtractExtractXhsArticleWebinfoBaseinfo baseInfo;

  string url;
};

type XhsArticleExtractExtractXhsArticleWebinfoArticleinfo = {
  string desc;

  string ipLocation;

  int lastUpdateTime;

  string noteId;

  int time;

  string title;

  string type_;

  string xsecToken;
};

type XhsArticleExtractExtractXhsArticleWebinfoBaseinfo = {
  string collectedCount;

  string commentCount;

  string desc;

  array<any> imageList;

  string likedCount;

  string nickname;

  string shareCount;

  string title;

  string type_;

  string videoUrl;
};

@capability failure_branch=true, timeout_ms=180000
function extract_xhs_article_webinfo(string url) -> XhsArticleExtractExtractXhsArticleWebinfoResult {}
