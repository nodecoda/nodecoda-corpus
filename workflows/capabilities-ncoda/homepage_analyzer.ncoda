// homepage_analyzer.ncoda — capability header (provider = file name)
// desc: 主页分析
@language nodecoda/1

type HomepageAnalyzerHomepageGetDataResult = {
  HomepageAnalyzerHomepageGetDataData data;

  string msg;

  int status_code;
};

type HomepageAnalyzerHomepageGetDataData = {
  HomepageAnalyzerHomepageGetDataDataAuthor author;

  array<any> aweme_list;

  string linkPlatform;

  int max_cursor;
};

type HomepageAnalyzerHomepageGetDataDataAuthor = {
  string avatar;

  string nickname;
};

@capability failure_branch=true, timeout_ms=180000
function homepage_get_data(any homelink, any max_cursor) -> HomepageAnalyzerHomepageGetDataResult {}
