// byteartist.ncoda — capability header (provider = file name)
// desc: ByteArtist
@language nodecoda/1

type ByteartistImage = {
  string image_url;
};

type ByteartistText2imageResult = {
  ByteartistText2imageData data;

  string log_id;

  string msg;

  float status_code;
};

type ByteartistText2imageData = {
  array<ByteartistImage> images;
};

@capability failure_branch=true, timeout_ms=180000
function text2image(int ddm_steps = 0, int height = 0, int model_type = 0, string negative_prompt = "", string prompt, int ratio = 0, float scale = 0, int seed = 0, int width = 0) -> ByteartistText2imageResult {}
